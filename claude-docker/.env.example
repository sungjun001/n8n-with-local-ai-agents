# =========================================
# Claude Docker 환경 변수 예제 (.env.example)
# =========================================

# 1. Google Gemini API 설정
# Gemini Pro Vision 등을 사용하기 위한 API Key
# 획득: https://aistudio.google.com/app/apikey
NANOBANANA_GEMINI_API_KEY=your_gemini_api_key_here
STITCH_API_KEY=your_stitch_api_key_here

# 2. MinIO (S3 호환 스토리지) 설정
# 이미지 업로드를 위한 외부 MinIO 서버 정보
# [Option A] 외부 도메인 (Reverse Proxy 사용 시): s3.yourdomain.com
# [Option B] 로컬 직접 연결 (Docker 내부): minio:9000
MINIO_ENDPOINT=s3.yourdomain.com
MINIO_ROOT_USER=admin          # Access Key
MINIO_ROOT_PASSWORD=password   # Secret Key (8자리 이상)
MINIO_BUCKET=images            # 업로드할 버킷 이름

# 3. Claude Bridge 접속 설정 (내부 통신용)
# claude-bridge 컨테이너가 claude-server에 접속할 때 사용
BRIDGE_SSH_HOST=claude-ssh-server
BRIDGE_SSH_USER=claudeuser
BRIDGE_SSH_PASS=1234

# 4. 모니터링 및 부가 설정
# Claude Code Monitor 주소 (보통 내부 컨테이너 주소 사용)
CLAUDE_MONITOR_URL=http://claude-code-monitor:3001

# 5. GitHub Integration (Optional)
# Required for 'plugin:github' (Claude Code)
# GITHUB_PERSONAL_ACCESS_TOKEN=ghp_xxxxxxxxxxxx
